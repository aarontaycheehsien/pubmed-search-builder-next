# NCBI E-utilities settings. Copy to .env at the skill root (never commit .env).
# Process environment variables take precedence over this file.

# Recommended: identifies you to NCBI.
NCBI_EMAIL=your.email@example.com

# Optional: raises the rate limit from 3 to 10 requests per second.
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Optional: tool name sent to NCBI.
# NCBI_TOOL=pubmed-search-builder

# Optional: set to off to disable the workspace response cache.
# PSB_CACHE=on
